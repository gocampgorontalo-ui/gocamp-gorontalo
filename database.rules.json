{
  "rules": {
    ".read": false,
    ".write": false,

    "stats": {
      ".read": true,
      ".write": false
    },

    "guestbook": {
      ".read": true,
      ".indexOn": ["timestamp"],
      "$id": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['username','category','message','timestamp'])",
        "username":  { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30" },
        "category":  { ".validate": "newData.isString() && newData.val().length <= 30" },
        "message":   { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 300" },
        "timestamp": { ".validate": "newData.isNumber()" },
        "$other":    { ".validate": false }
      }
    },

    "discordChat": {
      ".read": true,
      ".write": false,
      ".indexOn": ["timestamp"]
    }
  }
}
